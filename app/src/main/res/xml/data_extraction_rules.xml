<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup / device transfer. Include Room DB + DataStore so measurement
  history and settings survive reinstalls (and phone-to-phone transfers).
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="freescale.db" />
        <include domain="database" path="freescale.db-shm" />
        <include domain="database" path="freescale.db-wal" />
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="freescale.db" />
        <include domain="database" path="freescale.db-shm" />
        <include domain="database" path="freescale.db-wal" />
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
