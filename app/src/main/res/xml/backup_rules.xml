<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup / cloud restore: keep settings + measurement history across reinstalls
  when the user has device backups enabled.
-->
<full-backup-content>
    <include domain="database" path="freescale.db" />
    <include domain="database" path="freescale.db-shm" />
    <include domain="database" path="freescale.db-wal" />
    <include domain="file" path="datastore/" />
    <include domain="sharedpref" path="." />
</full-backup-content>
