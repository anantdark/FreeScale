<?xml version="1.0" encoding="utf-8"?>
<!--
    Launcher icon background: deep violet gradient with a soft off-centre highlight.

    Two stacked full-bleed paths. The first is the base diagonal gradient, in the
    same tonal family as the app's Material 3 seed colour (#6650A4). The second is
    a radial white wash centred up and to the left, which keeps the icon from
    looking like flat vinyl at large sizes.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- base gradient, top-left to bottom-right -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item
                    android:color="#FF5B3FD6"
                    android:offset="0.0" />
                <item
                    android:color="#FF2E1A6B"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- highlight, giving the surface some curvature -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="26"
                android:centerY="17"
                android:gradientRadius="104">
                <item
                    android:color="#3AFFFFFF"
                    android:offset="0.0" />
                <item
                    android:color="#00FFFFFF"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
