<?xml version="1.0" encoding="utf-8"?>
<!--
    Launcher icon foreground: a measurement dial over a weighing platform.

    Layers, back to front:
      1. track arc      the full dial sweep, white at 20% - the "unfilled" part
      2. progress arc   the same sweep cut short, filled with a mint-to-sky
                        gradient, so the dial reads as a live value
      3. platform bar   what makes this a scale rather than a speedometer
      4. needle         tapered triangle, aimed at the progress arc's leading end
      5. hub            solid white; an inner dot was tried and turns to mush at 48px

    Geometry, in the 108x108 adaptive viewport. Keep in sync with
    ic_launcher_monochrome.xml, which is the same mark as a flat silhouette.

      dial centre / pivot   (54, 61)
      dial radius           26,  stroke 9.5
      track sweep           195deg -> 345deg  =>  (28.886, 54.271) -> (79.114, 54.271)
      progress sweep        195deg -> 300deg  =>  (28.886, 54.271) -> (67.0, 38.483)
      needle                17 units at 300deg, half-width 4.2
                            tip (62.5, 46.278), base (57.637, 63.1) / (50.363, 58.9)
      hub                   r = 6
      platform bar          y = 75, x 37 -> 71, stroke 6.5

    Adaptive icons mask away everything outside a 72dp circle centred on (54, 54).
    Allowing for stroke width, the outermost point here sits at radius ~30 of that
    centre, inside the 33 limit, so no launcher mask clips anything meaningful.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 1. dial track -->
    <path
        android:pathData="M28.886,54.271 A26,26 0 0 1 79.114,54.271"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeAlpha="0.2"
        android:strokeWidth="9.5"
        android:strokeLineCap="round" />

    <!-- 2. progress arc -->
    <path
        android:pathData="M28.886,54.271 A26,26 0 0 1 67,38.483"
        android:fillColor="#00000000"
        android:strokeWidth="9.5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="108"
                android:endX="108"
                android:endY="0">
                <item
                    android:color="#FF5EEAD4"
                    android:offset="0.0" />
                <item
                    android:color="#FF38BDF8"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 3. weighing platform -->
    <path
        android:pathData="M37,75 L71,75"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="6.5"
        android:strokeLineCap="round" />

    <!-- 4. needle -->
    <path
        android:pathData="M57.637,63.1 L62.5,46.278 L50.363,58.9 Z"
        android:fillColor="#FFFFFFFF" />

    <!-- 5. needle hub -->
    <path
        android:pathData="M48,61 A6,6 0 0 1 60,61 A6,6 0 0 1 48,61 Z"
        android:fillColor="#FFFFFFFF" />
</vector>
